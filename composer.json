{
  "name": "themosis/framework",
  "description": "The Themosis framework.",
  "keywords": ["themosis", "framework", "wordpress"],
  "license": "GPL-2.0-or-later",
  "support": {
    "issues": "https://github.com/themosis/framework/issues",
    "source": "https://github.com/themosis/framework"
  },
  "authors": [
    {
      "name": "Julien Lambé",
      "email": "julien@themosis.com",
      "homepage": "https://www.themosis.com/"
    }
  ],
  "autoload": {
    "psr-4": {
      "Themosis\\": "src/"
    },
    "files": [
      "src/Core/aliases.php",
      "src/Core/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Themosis\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.3",
    "composer/installers": "^2",
    "dragonmantank/cron-expression": "^3.4",
    "filp/whoops": "^2.1",
    "guzzlehttp/guzzle": "^7.8.2|^8.0",
    "illuminate/auth": "^13.35",
    "illuminate/broadcasting": "^13.35",
    "illuminate/bus": "^13.35",
    "illuminate/cache": "^13.35",
    "illuminate/config": "^13.35",
    "illuminate/contracts": "^13.35",
    "illuminate/console": "^13.35",
    "illuminate/container": "^13.35",
    "illuminate/cookie": "^13.35",
    "illuminate/database": "^13.35",
    "illuminate/encryption": "^13.35",
    "illuminate/events": "^13.35",
    "illuminate/filesystem": "^13.35",
    "illuminate/hashing": "^13.35",
    "illuminate/http": "^13.35",
    "illuminate/log": "^13.35",
    "illuminate/mail": "^13.35",
    "illuminate/notifications": "^13.35",
    "illuminate/pagination": "^13.35",
    "illuminate/queue": "^13.35",
    "illuminate/redis": "^13.35",
    "illuminate/routing": "^13.35",
    "illuminate/session": "^13.35",
    "illuminate/support": "^13.35",
    "illuminate/testing": "^13.35",
    "illuminate/validation": "^13.35",
    "illuminate/view": "^13.35",
    "laravel/tinker": "^3.0",
    "laravel/ui": "^4.0",
    "league/flysystem": "^3.29.1",
    "league/fractal": "^0.20|^0.21",
    "paragonie/sodium_compat": "^1.24.2|^2.5.2",
    "predis/predis": "^2.3|^3.0",
    "ramsey/uuid": "^4.7",
    "spatie/enum": "^3.13",
    "symfony/property-access": "^7.4|^8.0",
    "twig/twig": "^3.1",
    "vlucas/phpdotenv": "^5.6.1"
  },
  "require-dev": {
    "fakerphp/faker": "^1.9.1",
    "friendsofphp/php-cs-fixer": "^3.8",
    "johnpbloch/wordpress-core": "^6.8.1|^7.0",
    "phpunit/phpunit": "^12.5.8|^13.0.3",
    "symfony/var-dumper": "^7.4|^8.0",
    "brianium/paratest": "^7.20",
    "symfony/process": "^7.4.5|^8.0.5"
  },
  "scripts": {
    "test": "phpunit",
    "fix": "php-cs-fixer fix"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "composer/installers": true
    }
  },
  "extra": {
    "branch-alias": {
      "dev-master": "13.x-dev"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
